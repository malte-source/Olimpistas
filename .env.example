# Olimpistas — variables de entorno (copiar a .env)
# En producción los secretos viven en Secret Manager (Cloud Run), nunca en el repo.
# El test test/calidad.test.js exige que toda variable que lee el código esté documentada acá.

# ── Servidor ─────────────────────────────────────────────────────────────────
# Puerto local (Cloud Run inyecta PORT automáticamente).
PORT=3002
# URL pública, para links en correos y en el sitemap.
# APP_URL=https://www.olimpistas.com
# 'staging' en el entorno de pruebas: muestra la cinta de aviso y aísla correo/Tuti/Pagopar.
# ENTORNO=staging
# Nivel de log (pino): debug | info | warn | error.
# LOG_LEVEL=info

# ── Base de datos ────────────────────────────────────────────────────────────
# Base PROPIA de Olimpistas. Sin esta variable, la app usa un store en memoria con
# datos semilla (modo demo). Las tablas las crean las migraciones de /migraciones.
# En Supabase usar el pooler (puerto 6543).
# OLIMPISTAS_DATABASE_URL=postgres://usuario:pass@host:5432/olimpistas
# 1 = aplicar migraciones pendientes al arrancar (en prod se corren antes del deploy).
# MIGRAR_AL_ARRANCAR=1
# Desactivar la persistencia del store en memoria a JSON (0 = en memoria pura).
# OLIMPISTAS_PERSIST=0
# 'disable' para una base local sin SSL.
# DB_SSL=disable
# DB_POOL_MAX=6          # conexiones por instancia (instancias × este valor < límite del pooler)
# DB_MAX_LIFETIME=1800   # segundos antes de reciclar una conexión
# DB_TIMEOUT_MS=8000     # tope por consulta
# DB_ESPERA_MS=15000     # espera máxima por una conexión libre

# ── Administración y seguridad ───────────────────────────────────────────────
# Clave del dueño (acceso total al panel). Una sola o varias separadas por coma en ADMIN_KEYS.
ADMIN_KEY=
# ADMIN_KEYS=clave1,clave2
# Secreto para los links de baja de correos (si falta, deriva de ADMIN_KEY: mejor fijarlo).
# UNSUB_SECRET=
# 0 = dejar de aceptar los links de baja viejos firmados con la clave anterior.
# UNSUB_ACEPTAR_LEGADO=0
# Secreto que autentica los disparadores del cron (/api/cron/*). Mínimo 24 caracteres.
# CRON_SECRET=

# ── Pagos — PAGOPAR ──────────────────────────────────────────────────────────
# Con ambos tokens se activa el cobro real; sin ellos funciona en modo simulado.
# PAGOPAR_PUBLIC_TOKEN=
# PAGOPAR_PRIVATE_TOKEN=
# PAGOPAR_API_URL=
# PAGOPAR_CHECKOUT_URL=
# 1 = cobrar las preventas de verdad (mientras no, se cobran en modo prueba).
# PAGOPAR_PREVENTAS_LIVE=0
# Links de pago de respaldo por nivel (si no hay Pagopar).
# LINK_PAGO_PLUS_GS=
# LINK_PAGO_PLUS_USD=
# LINK_PAGO_JUNIOR_GS=
# LINK_PAGO_JUNIOR_USD=
# Cuota anual de socio en guaraníes (0 = sin cuota informada).
# CUOTA_SOCIO_GS=0
# Guaraníes por dólar para mostrar referencias en USD.
# USD_RATE=7300

# ── API de socios del club (ITI/Tuti) ────────────────────────────────────────
# Estado en vivo por cédula. Sin ambas keys queda deshabilitada y la validación de socio
# usa sólo el padrón. En prod: Secret Manager.
TUTI_API_KEY=
TUTI_MERCHANT_KEY=
# TUTI_API_HOST=https://bff.tuti.com.py
# TUTI_TIMEOUT_MS=2500
# Estados de Tuti que cuentan como socio vigente.
# TUTI_ESTADOS_VALIDOS=ACTIVE,LIFETIME,DEBT
# 1 = activar la ticketera (Partidos / Liberá tu lugar) cuando Tuti habilite los endpoints nuevos.
# TUTI_TICKETERA=0
# TUTI_TICKETERA_URL=https://...   # dónde Tuti vende las entradas

# ── Correo ───────────────────────────────────────────────────────────────────
# RESEND_API_KEY=
# EMAIL_FROM=Olimpistas <hola@olimpistas.com>
# Secreto del webhook de Resend (rebotes y quejas).
# RESEND_WEBHOOK_SECRET=
# off = apagar el aviso de verificación de correo (kill-switch en vivo; la cuenta funciona igual sin verificar).
# EMAIL_VERIF=on

# ── Campañas de correo (apagadas hasta que se decida) ────────────────────────
# CAMPANAS_ACTIVAS=1 enciende los envíos; sin eso solo se arman y se previsualizan.
# CAMPANAS_ACTIVAS=0
# CAMPANAS_LOTE=120       # destinatarios por tanda (máx. 400)
# CAMPANAS_PAUSA_MS=340   # pausa entre correos (respeta el límite del proveedor)

# ── Alertas ──────────────────────────────────────────────────────────────────
# A dónde avisar cuando algo falla (webhook y/o correo).
# ALERT_WEBHOOK_URL=
# ALERT_EMAIL=
# ALERT_COOLDOWN_MS=600000   # no repetir la misma alerta antes de este lapso

# ── Asistente de atención (IA) ───────────────────────────────────────────────
# (Gemini como motor principal llega con el PR #12: GEMINI_API_KEY, ATENCION_MODELO_GEMINI, ATENCION_PROVEEDOR.)
# ANTHROPIC_API_KEY=
# ATENCION_MODELO=claude-haiku-5-5
# Mensajes por ráfaga y tope diario por persona.
# ATENCION_RAFAGA=8
# ATENCION_TOPE_DIARIO=40

# ── Integraciones y analítica ────────────────────────────────────────────────
# GoHighLevel: webhook de leads y de WhatsApp.
# GHL_WEBHOOK_URL=
# GHL_WHATSAPP_URL=
# PLAUSIBLE_DOMAIN=olimpistas.com
# GA_ID=
# META_PIXEL_ID=
# GOOGLE_SITE_VERIFICATION=

# ── Reglas de negocio ────────────────────────────────────────────────────────
# Tope de una puja en guaraníes (protege de un cero de más).
# PUJA_MAX=200000000
# Hasta qué día del mes se revisan las cuotas de socio para los puntos.
# PUNTOS_CUOTA_DIAS=5
# Fecha ISO de arranque de la rampa del contador; sin ella se muestra el agregado tal cual (no modificar sin acordarlo).
# RAMP_INICIO=
