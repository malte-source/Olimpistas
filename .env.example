# Olimpistas — variables de entorno (copiar a .env)

# Puerto local (Cloud Run inyecta PORT automáticamente).
PORT=3002

# Base de datos PROPIA de Olimpistas. Sin esta variable, la app usa un store en
# memoria con datos semilla (modo demo). Aplicar data/schema.sql antes de usarla.
# OLIMPISTAS_DATABASE_URL=postgres://usuario:pass@host:5432/olimpistas

# Desactivar la persistencia del store en memoria a JSON (1 = en memoria pura).
# OLIMPISTAS_PERSIST=0

# PAGOPAR (pasarela de pagos). Con ambos tokens se activa el cobro real.
# PAGOPAR_PUBLIC_TOKEN=
# PAGOPAR_PRIVATE_TOKEN=
# PAGOPAR_ENV=sandbox   # 'prod' para producción
