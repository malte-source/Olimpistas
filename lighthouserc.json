{
  "ci": {
    "collect": {
      "startServerCommand": "node server.js",
      "startServerReadyPattern": "(?i)escuch|listening|puerto|port",
      "url": ["http://localhost:3000/", "http://localhost:3000/en", "http://localhost:3000/ayuda", "http://localhost:3000/legal"],
      "numberOfRuns": 3,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.85 }],
        "categories:accessibility": ["warn", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.05 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 300 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
